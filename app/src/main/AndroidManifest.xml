<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- M0 不連網：不得宣告網路權限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 讀取當下前景 App（只在收到推播時讀一次），使用者要在系統設定自行開啟 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ 套件可見性：要宣告才找得到系統的語音辨識服務 -->
    <queries>
        <!-- 讓 App 查得到桌面上的應用程式分類（判斷是否為遊戲） -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name=".PetApp"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AccompanyPet">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 聊天畫面：只由懸浮角色的「聊聊」開啟，不讓其他 App 叫起（A23） -->
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:label="聊聊"
            android:windowSoftInputMode="adjustResize" />

        <!-- 盤前均線畫面：只由懸浮角色的「看明細」或點通知開啟，不讓其他 App 叫起（A44） -->
        <activity
            android:name=".MaActivity"
            android:exported="false"
            android:label="盤前均線"
            android:windowSoftInputMode="adjustResize" />

        <!-- 戒飲設定：只由主畫面的「戒飲設定」按鈕開啟（M2） -->
        <activity
            android:name=".DrinkSettingsActivity"
            android:exported="false"
            android:label="戒飲設定"
            android:windowSoftInputMode="adjustResize" />

        <!-- 看不見的收音畫面：只由懸浮角色的「說話」開啟，辨識期間讓 App 在前景（系統才給麥克風）；
             獨立的 taskAffinity，避免把主畫面一起帶到前面 -->
        <activity
            android:name=".ListenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:theme="@style/Theme.AccompanyPet.Listen" />

        <!-- 通知按鈕「沒喝」「有喝，用說的」：只接受本 App 通知送來的廣播（M2） -->
        <receiver
            android:name=".DrinkActionReceiver"
            android:exported="false" />

        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="桌面懸浮陪伴角色，需常駐顯示並在使用者點擊時接收語音" />
        </service>

        <!-- 只接受 Firebase 程式庫轉交的推播（A14） -->
        <service
            android:name=".PetMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 快速設定磚：只有系統能綁定（A9） -->
        <service
            android:name=".PetTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="🐾 陪伴角色"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
