<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 標題列 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="⚙️ 偏好與非功能類設定"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseSheet"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:backgroundTint="#33FFFFFF"
            android:text="完成"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="480dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 系統權限區塊 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:text="系統權限管理"
                android:textColor="#99EBEBF5"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#12FFFFFF"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/sheetOverlayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/sheetGrantOverlayBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#0A84FF"
                    android:text="前往授權「顯示在其他應用程式上層」"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="#1AFFFFFF" />

                <TextView
                    android:id="@+id/sheetUsageStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/sheetGrantUsageBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#FF9F0A"
                    android:text="前往開啟「使用情形存取權」"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/sheetGrantMicBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#33FFFFFF"
                    android:text="允許麥克風權限（用說的）"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 遊戲與推播區塊 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="遊戲與推播設定"
                android:textColor="#99EBEBF5"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#12FFFFFF"
                android:orientation="vertical"
                android:padding="12dp">

                <EditText
                    android:id="@+id/sheetCustomGamesInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1AFFFFFF"
                    android:hint="自訂遊戲清單：一行一個套件名稱"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#66EBEBF5"
                    android:padding="10dp"
                    android:minLines="3"
                    android:gravity="top"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/sheetSaveGamesBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#0A84FF"
                    android:text="儲存自訂遊戲清單"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="#1AFFFFFF" />

                <TextView
                    android:id="@+id/sheetPushCodeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#CCEBEBF5"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/sheetCopyPushBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="#33FFFFFF"
                        android:text="複製推播代碼"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/sheetTestPushBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="#33FFFFFF"
                        android:text="測試推播"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/sheetResendPushBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="#33FFFFFF"
                        android:text="重送上一則"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 進階與開發者選項 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="高級分析與開發者選項"
                android:textColor="#99EBEBF5"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#12FFFFFF"
                android:orientation="vertical"
                android:padding="12dp">

                <Button
                    android:id="@+id/sheetExportBatteryBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#33FFFFFF"
                    android:text="匯出耗電紀錄 (CSV)"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/sheetTestModeBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#33FFFFFF"
                    android:text="耗電測試模式：關"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
